# Copy to .env (gitignored) and fill in only what you use. Never commit real keys.
# The planner LLM benchmark (R-1) reads these: uv run --group llm --env-file ../.env ...

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A paid key: free-tier Gemini content may be used to improve Google's products.
GEMINI_API_KEY=
# Only for open-weight models without a local GPU (quality numbers, not latency).
OPENROUTER_API_KEY=
# Optional: a model server other than this machine's Ollama.
# OLLAMA_HOST=http://localhost:11434
