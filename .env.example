# Copy to .env (gitignored) and fill in only what you use. Never commit real keys.
# The planner LLM benchmark (R-1) reads these: uv run --group llm --env-file ../.env ...
# R-1b has no budget: only the free and local candidates run (paid ones need --allow-paid).

# Free tiers. Only text is sent (the request and the tool list), which D-017 allows.
GROQ_API_KEY=
# A free AI Studio key: free-tier content is used to improve Google's products.
GEMINI_API_KEY=
# For the ":free" models (quality numbers only: the proxy hop makes latency not comparable).
OPENROUTER_API_KEY=
# Optional: a model server other than this machine's Ollama.
# OLLAMA_HOST=http://localhost:11434

# Paid APIs, never run without --allow-paid.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
