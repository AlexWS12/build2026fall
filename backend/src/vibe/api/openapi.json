                "schema": {
                  "$ref": "#/components/schemas/TimelineState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/transcript": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Transcribe Project",
        "description": "The video's transcript with word timestamps (F-31), from the cache or made now.\n\nMaking one runs Whisper and can take a while; the project is busy (409) until it's done.\n503 when the server can't transcribe (stub backend with no cached transcript, or no model).",
        "operationId": "transcribe_project_api_projects__project_id__transcript_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transcript"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/history": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Get History",
        "description": "The requests in the op log, and whether undo and redo have something to act on.",
        "operationId": "get_history_api_projects__project_id__history_get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
