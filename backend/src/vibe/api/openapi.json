              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/undo": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Undo",
        "description": "Undo the latest request in effect. 400 if there is nothing to undo.",
        "operationId": "undo_api_projects__project_id__undo_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/redo": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Redo",
        "description": "Bring back the most recently undone request. 400 if there is nothing to redo.",
        "operationId": "redo_api_projects__project_id__redo_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/tracks": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Get Tracks",
        "description": "Where the targets are over time, for drawing boxes over the preview.",
        "operationId": "get_tracks_api_projects__project_id__tracks_get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TracksReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/analysis": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Analyse",
        "description": "Make sure the video has a vision analysis (F-10). 503 when this server can't provide one.\n\nFor now this only replays the shared cache: no detector is connected to the API yet, on any\nbackend, so a video nobody analysed gets 503 rather than an empty result.",
        "operationId": "analyse_api_projects__project_id__analysis_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/exports": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Create Export",
        "description": "Render the timeline into a new MP4 in the project's ``exports/``. 422 with the reason\nwhen the timeline has an edit the renderer can't apply yet, or cuts that leave nothing.",
        "operationId": "create_export_api_projects__project_id__exports_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportReply"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{project_id}/exports/{name}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Get Export",
        "description": "One rendered MP4, by the name ``POST .../exports`` returned.",
        "operationId": "get_export_api_projects__project_id__exports__name__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The MP4.",
            "content": {
              "video/mp4": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisReply": {
        "properties": {
          "analysed": {
            "type": "boolean",
            "title": "Analysed"
          },
          "tracks": {
            "type": "integer",
            "title": "Tracks",
            "description": "How many tracks GET .../tracks now returns."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysed",
          "tracks"
        ],
        "title": "AnalysisReply"
      },
      "AudioFilterSpan": {
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "End",
            "description": "Null means until the end of the video."
          },
          "op_id": {
            "type": "string",
            "title": "Op Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "filter": {
            "type": "string",
            "const": "denoise",
            "title": "Filter"
          },
          "strength": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strength"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "op_id",
          "request_id",
          "filter"
        ],
        "title": "AudioFilterSpan"
      },
      "Body_create_project_api_projects_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_project_api_projects_post"
      },
      "ChatMessage": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "clarify",
              "not_applied"
            ],
            "title": "Status"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepReport"
            },
            "type": "array",
            "title": "Steps"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "text",
          "status",
          "reply",
          "at"
        ],
        "title": "ChatMessage",
        "description": "One past chat request with its reply, as stored in the project's ``chat.jsonl``."
      },
      "ChatReply": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id",
            "description": "Ops written for this request carry this id."
          },
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "clarify",
              "not_applied"
            ],
            "title": "Status",
            "description": "applied: the plan ran and its ops are in the timeline. clarify: the reply is a question; nothing was written. not_applied: a tool refused, so nothing was written; the reply says why."
          },
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "Shown to the user in the chat."
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepReport"
            },
            "type": "array",
            "title": "Steps",
            "description": "The tool calls that ran, in order, up to and including one that failed."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "reply"
        ],
        "title": "ChatReply"
      },
      "ChatRequest": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "title": "Text",
            "description": "The user's chat message."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ChatRequest"
      },
      "Effect": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "blur",
              "pixelate",
              "box"
            ],
            "title": "Type"
          },
          "padding": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Padding",
            "description": "Grow the box by this fraction of its size.",
            "default": 0.15
          },
          "strength": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Strength",
            "description": "0 = lightest, 1 = strongest. Null = default."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Effect",
        "description": "How to hide a visual target. The renderer owns what each setting looks like."
      },
      "ExportReply": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Where to GET the MP4."
          },
          "duration": {
            "type": "number",
            "title": "Duration",
            "description": "Length of the output in seconds."
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues",
            "description": "What the renderer masked more because of (a lost track, a missing one)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "url",
          "duration",
          "issues"
        ],
        "title": "ExportReply"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "backend": {
            "type": "string",
            "enum": [
              "stub",
              "local",
              "remote"
            ],
            "title": "Backend"
          }
        },
        "type": "object",
        "required": [
          "status",
          "backend"
        ],
        "title": "Health"
      },
      "HistoryEntry": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "agent",
              "user"
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "undone"
            ],
            "title": "Status"
          },
          "kinds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Kinds",
            "description": "The kind of each op the request wrote, in log order."
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "The chat message, if it was a chat request."
          },
          "reply": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
