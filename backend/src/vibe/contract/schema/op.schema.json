{
  "$defs": {
    "AddAudioFilter": {
      "additionalProperties": false,
      "description": "Apply an audio filter (e.g. denoise) over a time range (the whole clip if null).",
      "properties": {
        "op_id": {
          "description": "Unique in the log.",
          "title": "Op Id",
          "type": "string"
        },
        "request_id": {
          "description": "The chat message or UI action that caused this op. Undo works per request.",
          "title": "Request Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "agent",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "kind": {
          "const": "add_audio_filter",
          "default": "add_audio_filter",
          "title": "Kind",
          "type": "string"
        },
        "filter": {
          "const": "denoise",
          "title": "Filter",
          "type": "string"
        },
        "strength": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strength"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id",
        "source",
        "filter"
      ],
      "title": "AddAudioFilter",
      "type": "object"
    },
    "AddMask": {
      "additionalProperties": false,
      "description": "Hide targets with an effect over a time range (the whole clip if ``time_range`` is null).\n\nWhere targets overlap an earlier mask, this op wins over its own range.",
      "properties": {
        "op_id": {
          "description": "Unique in the log.",
          "title": "Op Id",
          "type": "string"
        },
        "request_id": {
          "description": "The chat message or UI action that caused this op. Undo works per request.",
          "title": "Request Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "agent",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "kind": {
          "const": "add_mask",
          "default": "add_mask",
          "title": "Kind",
          "type": "string"
        },
        "targets": {
          "description": "Track ids from the analysis cache.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id",
        "source",
        "targets",
        "effect"
      ],
      "title": "AddMask",
      "type": "object"
    },
