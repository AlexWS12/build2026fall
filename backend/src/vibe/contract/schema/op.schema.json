            "agent",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "kind": {
          "const": "cut",
          "default": "cut",
          "title": "Kind",
          "type": "string"
        },
        "time_range": {
          "$ref": "#/$defs/TimeRange"
        }
      },
      "required": [
        "request_id",
        "source",
        "time_range"
      ],
      "title": "Cut",
      "type": "object"
    },
    "Effect": {
      "additionalProperties": false,
      "description": "How to hide a visual target. The renderer owns what each setting looks like.",
      "properties": {
        "type": {
          "enum": [
            "blur",
            "pixelate",
            "box"
          ],
          "title": "Type",
          "type": "string"
        },
        "padding": {
          "default": 0.15,
          "description": "Grow the box by this fraction of its size.",
          "maximum": 1,
          "minimum": 0,
          "title": "Padding",
          "type": "number"
        },
        "strength": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0 = lightest, 1 = strongest. Null = default.",
          "title": "Strength"
        }
      },
      "required": [
        "type"
      ],
      "title": "Effect",
      "type": "object"
    },
    "Mute": {
      "additionalProperties": false,
      "description": "Silence a time range: all audio if ``speaker`` is null, else one speaker's voice.",
