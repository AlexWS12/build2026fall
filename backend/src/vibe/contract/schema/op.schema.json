      ],
      "title": "AddRule",
      "type": "object"
    },
    "Cut": {
      "additionalProperties": false,
      "description": "Remove a time range from the output. Overlapping cuts merge.",
      "properties": {
        "op_id": {
          "description": "Unique in the log.",
          "title": "Op Id",
          "type": "string"
        },
        "request_id": {
          "description": "The chat message or UI action that caused this op. Undo works per request.",
